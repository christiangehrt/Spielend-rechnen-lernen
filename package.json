{
  "name": "spielend-rechnen-lernen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline-fähige Mathe-Spielesammlung (PWA) für Kinder ab 6 Jahren",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "assets:sounds": "python3 scripts/generate-ui-sounds.py",
    "assets:icons": "node scripts/generate-icons.mjs",
    "assets:twemoji": "node scripts/copy-twemoji.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@twemoji/svg": "^15.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  }
}
